# Demo mode is the default (QUOTECHECK_USE_OPENAI=0) and needs NO API key at all —
# you don't even need to copy this file to backend/.env to try it.
# OPENAI_API_KEY below is only required if you set QUOTECHECK_USE_OPENAI=1.
OPENAI_API_KEY=your_key_here

# Feature flags
QUOTECHECK_USE_OPENAI=0

# Allowed browser origins for CORS: comma-separated EXACT origins
# (scheme + host + optional port, no path/query/fragment). Unset -> the local
# Vite dev server (http://localhost:5173, http://127.0.0.1:5173). For the public
# Demo, set this to the Vercel frontend origin, e.g.
#   QUOTECHECK_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Wildcard "*" is rejected; an explicitly-set-but-empty value fails startup.
QUOTECHECK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PORT is supplied by the hosting platform (Railway) and consumed by the start
# command as --port $PORT. Locally you pass --port 8000 yourself.

# Model choice
QUOTECHECK_MODEL=gpt-4o-mini

# OpenAI-mode per-attempt request timeout, in seconds (default 30 if unset).
# Must be a finite, positive number; a bad value is rejected as a
# configuration_error. QuoteCheck makes at most 2 provider calls per request.
QUOTECHECK_OPENAI_TIMEOUT_SECONDS=30

# Logging
QUOTECHECK_LOG_PATH=logs/app_runs.jsonl
